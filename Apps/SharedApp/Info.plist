<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- processed by the macOS CI build (Xcode 16.4, unsigned, all four platforms), never run -->
<!-- Shared by the iOS and the macOS app targets (Apps/project.yml). Holds only
     what Xcode cannot generate; everything else comes from
     GENERATE_INFOPLIST_FILE and the INFOPLIST_KEY_ build settings. -->
<plist version="1.0">
<dict>
	<key>NPAppGroupIdentifier</key>
	<string>$(NP_APP_GROUP)</string>
	<!-- Bundle identifier of the Xray extension (TunnelEngineCatalog); differs from app + ".PacketTunnelXray" in the Byk build. -->
	<key>NPXrayExtensionBundleIdentifier</key>
	<string>$(NP_XRAY_EXTENSION_BUNDLE_ID)</string>
	<!-- Bundle identifier of the Mihomo extension; com.gbnconnect.app.mihomo in the Byk build. -->
	<key>NPMihomoExtensionBundleIdentifier</key>
	<string>$(NP_MIHOMO_EXTENSION_BUNDLE_ID)</string>
</dict>
</plist>
