#include "Base.xcconfig"
// Build flavour MihomoOnly (ADR-0007): one Packet Tunnel extension (PacketTunnelMihomo) with the Mihomo bridge
// (NPMihomoBridge.xcframework). The whole product counts as GPL-3.0 (ADR-0006). Target: AppMihomoOnly_<platform>,
// scheme NetworkPlatform-MihomoOnly-<platform> (Apps/project.yml, ADR-0009).
NP_FLAVOUR = MihomoOnly
NP_FLAVOUR_CONDITIONS = NP_ENGINE_MIHOMO

// Developer identity, never committed.
#include? "Local.xcconfig"
