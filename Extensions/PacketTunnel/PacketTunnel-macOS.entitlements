<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- UNVERIFIED: never used for signing. The macOS CI builds are unsigned (CODE_SIGNING_ALLOWED=NO), so
     these entitlements were not applied or checked against a provisioning profile. -->
<!-- macOS app extension (Mac App Store packaging, used for development, ADR-0005 §3).
     The Developer ID system-extension variant needs a different file and is not written. -->
<plist version="1.0">
<dict>
	<key>com.apple.developer.networking.networkextension</key>
	<array>
		<string>packet-tunnel-provider</string>
	</array>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(NP_APP_GROUP)</string>
	</array>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
